# Salin file ini menjadi .env lalu isi API key kamu.
# JANGAN commit file .env ke Git!

# --- AgentRouter (https://agentrouter.org) ---
# Key lama: bisa semua model (claude + gpt) di kedua endpoint
AGENTROUTER_API_KEY=
# Key baru (opsional): hanya model gpt-5.6-sol
AGENTROUTER_API_KEY_OPENAI=

# --- Groq (https://console.groq.com) ---
GROQ_API_KEY=

# Tambah provider lain di sini sesuai kebutuhan
